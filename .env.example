# ============================================================
# ONE UML - SRS Generator Tools
# Environment Variables Template
#
# CARA PAKAI:
# 1. Salin file ini: copy .env.example .env
# 2. Isi nilai di .env sesuai environment kamu
# 3. JANGAN pernah commit file .env ke Git!
# ============================================================

# ============================================================
# DJANGO CORE
# ============================================================

# Secret key untuk enkripsi session dan CSRF token.
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=ganti-dengan-secret-key-yang-aman-minimal-50-karakter

# Mode debug (True di dev, False di production)
DEBUG=True

# Host yang diizinkan (comma-separated)
# Di production: isi dengan domain kamu, misal: yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=127.0.0.1,localhost

# ============================================================
# DATABASE — PILIH SALAH SATU
# ============================================================

# === OPSI A: SQLite (Development Lokal) ===
# Hapus/comment baris DATABASE_URL di bawah untuk pakai SQLite lokal.
# File db.sqlite3 akan dibuat otomatis.

# === OPSI B: Supabase (PostgreSQL) — DIREKOMENDASIKAN ===
# Dapatkan connection string dari:
# Supabase Dashboard > Project Settings > Database > Connection string > URI
# PENTING: Gunakan mode "Transaction" (port 6543) bukan "Session" (port 5432)
# agar kompatibel dengan serverless/multi-worker.
#
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# === OPSI C: PostgreSQL self-hosted ===
# DATABASE_URL=postgresql://username:password@localhost:5432/nama_database

# Uncomment baris di bawah ini untuk mengaktifkan PostgreSQL:
# DATABASE_URL=postgresql://...
